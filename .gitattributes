# Normalize repo text files for clean GitHub diffs/renders.
*.md   text eol=lf
*.cpp  text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.ps1  text eol=lf
*.txt  text eol=lf

# Common image/binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.ico   binary
*.webp  binary
*.tif   binary
*.tiff  binary

# Windows/WDK build artifacts and signing/certificate outputs.
*.exe  binary
*.dll  binary
*.sys  binary
*.pdb  binary
*.cat  binary
*.cer  binary
